	partition MART_OCUPACAO_MENSAL = m
		mode: import
		source =
				let
				    Fonte = Snowflake.Databases("RZFQSVC-JX11949","COMPUTE_WH",[Implementation="2.0"]),
				    GUEST_FLOW_Database = Fonte{[Name="GUEST_FLOW",Kind="Database"]}[Data],
				    GOLD_MARTS_Schema = GUEST_FLOW_Database{[Name="GOLD_MARTS",Kind="Schema"]}[Data],
				    MART_OCUPACAO_MENSAL_Table = GOLD_MARTS_Schema{[Name="MART_OCUPACAO_MENSAL",Kind="Table"]}[Data]
				in
				    MART_OCUPACAO_MENSAL_Table

	annotation PBI_ResultType = Table


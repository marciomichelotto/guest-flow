	column 'Data Mes' = DATE(MART_OCUPACAO_MENSAL[ANO], MART_OCUPACAO_MENSAL[MES], 1)
		dataType: dateTime
		formatString: mmm/yyyy
		lineageTag: 38f65252-3756-4948-b53c-0b1280749dac
		summarizeBy: none

	column 'Mes Nome' = SWITCH(MART_OCUPACAO_MENSAL[MES], 1,"Jan",2,"Fev",3,"Mar",4,"Abr",5,"Mai",6,"Jun",7,"Jul",8,"Ago",9,"Set",10,"Out",11,"Nov",12,"Dez")

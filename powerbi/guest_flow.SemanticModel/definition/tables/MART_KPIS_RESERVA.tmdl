	column 'Lead Ordem' = SWITCH(MART_KPIS_RESERVA[LEAD_FAIXA], "<=7d", 1, "8-30d", 2, "31-90d", 3, ">90d", 4, BLANK())
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: b22ff02f-53fd-4849-9c74-9a599b9df006
		summarizeBy: none

	column Antecedencia = SWITCH(MART_KPIS_RESERVA[LEAD_FAIXA], "<=7d", "≤ 7 dias", "8-30d", "8–30 dias", "31-90d", "31–90 dias", ">90d", "> 90 dias", BLANK())
		dataType: string
		lineageTag: 9f9fbd75-ec38-4ded-ae74-571135428104
		summarizeBy: none
		sortByColumn: 'Lead Ordem'

	column 'Cidade Limpa' =
			VAR c = TRIM(MART_KPIS_RESERVA[CIDADE])
			VAR suf = UPPER(RIGHT(c, 3))
			VAR c2 = IF(suf = "-PR" || suf = "_PR", TRIM(LEFT(c, LEN(c) - 3)), c)
			RETURN IF(c2 = "", BLANK(), IF(CONTAINSSTRING(c2, "Londrina") && NOT CONTAINSSTRING(c2, "Nova"), "Londrina", c2))
		dataType: string
		lineageTag: f1b5ed29-1ab9-4125-8fc7-038ac6344097
		summarizeBy: none

	partition MART_KPIS_RESERVA = m
		mode: import
		source =
				let
				    Fonte = Snowflake.Databases("RZFQSVC-JX11949","COMPUTE_WH",[Implementation="2.0"]),
				    GUEST_FLOW_Database = Fonte{[Name="GUEST_FLOW",Kind="Database"]}[Data],
				    GOLD_MARTS_Schema = GUEST_FLOW_Database{[Name="GOLD_MARTS",Kind="Schema"]}[Data],
				    MART_KPIS_RESERVA_Table = GOLD_MARTS_Schema{[Name="MART_KPIS_RESERVA",Kind="Table"]}[Data]
				in
				    MART_KPIS_RESERVA_Table

	annotation PBI_ResultType = Table


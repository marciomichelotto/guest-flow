table MART_KPIS_RESERVA
	lineageTag: 7906b192-4ef0-4e6e-916c-449b15320708

	measure 'Receita Total (Reservas)' = SUM(MART_KPIS_RESERVA[VALOR_TOTAL])
		formatString: "R$"#,##0
		lineageTag: c1aef8cb-d808-4f06-945d-2b020ffa70f7

	measure '% Reservas em Grupo' = DIVIDE(CALCULATE(COUNTROWS(MART_KPIS_RESERVA), MART_KPIS_RESERVA[IS_GRUPO] = TRUE()), COUNTROWS(MART_KPIS_RESERVA))
		formatString: 0.0%
		lineageTag: f38978b1-09ea-4aa8-a8e4-08cd508fd53c

	measure 'Ticket Medio por Reserva' = DIVIDE(SUM(MART_KPIS_RESERVA[VALOR_TOTAL]), DISTINCTCOUNT(MART_KPIS_RESERVA[RESERVA]))
		formatString: "R$"#,##0
		lineageTag: a20e4b17-882b-4861-ac90-d743ed379b5c

	measure 'Permanencia Media (noites)' = AVERAGE(MART_KPIS_RESERVA[DIARIAS_TOTAL])
		formatString: 0.0
		lineageTag: a1f73949-6c5b-4148-af28-b5ca8bca1a3a

	measure '# Reservas' = COUNTROWS(MART_KPIS_RESERVA)
		formatString: #,##0
		displayFolder: Auxiliares
		lineageTag: 7660e4cb-fbf1-49fe-911f-25f185efa9f8

	measure '% Fora do PR' =
			VAR _comUF = CALCULATE(COUNTROWS(MART_KPIS_RESERVA), NOT ISBLANK(MART_KPIS_RESERVA[ESTADO]))
			VAR _foraPR = CALCULATE(COUNTROWS(MART_KPIS_RESERVA), NOT ISBLANK(MART_KPIS_RESERVA[ESTADO]), MART_KPIS_RESERVA[ESTADO] <> "PR")
			RETURN DIVIDE(_foraPR, _comUF)
		formatString: 0.0%
		displayFolder: Auxiliares
		lineageTag: 8c136b63-9124-4967-817a-29da46d55ce0

	measure 'Cobertura Origem Mapa' = DIVIDE(CALCULATE(COUNTROWS(MART_KPIS_RESERVA), MART_KPIS_RESERVA[ORIGEM_DADO] = "mapa_confirmado"), COUNTROWS(MART_KPIS_RESERVA))
		formatString: 0.0%
		displayFolder: Auxiliares
		lineageTag: a0439d89-d444-45d5-abc5-bed5517677cc

	measure 'Cobertura UF' = DIVIDE(CALCULATE(COUNTROWS(MART_KPIS_RESERVA), NOT ISBLANK(MART_KPIS_RESERVA[ESTADO])), COUNTROWS(MART_KPIS_RESERVA))
		formatString: 0.0%
		displayFolder: Auxiliares
		lineageTag: d9c2bf63-1a72-4cb4-8b3d-2796e80f938a

	measure 'Cobertura Cidade' = DIVIDE(CALCULATE(COUNTROWS(MART_KPIS_RESERVA), NOT ISBLANK(MART_KPIS_RESERVA[CIDADE])), COUNTROWS(MART_KPIS_RESERVA))
		formatString: 0.0%
		displayFolder: Auxiliares
		lineageTag: 449f1354-d31a-4f79-b2d3-a556e890a7c6

	measure 'Cobertura Antecedencia' = DIVIDE(CALCULATE(COUNTROWS(MART_KPIS_RESERVA), NOT ISBLANK(MART_KPIS_RESERVA[LEAD_FAIXA])), COUNTROWS(MART_KPIS_RESERVA))
		formatString: 0.0%
		displayFolder: Auxiliares
		lineageTag: 25e3cdd8-78b5-4610-ada0-ac86670a1f30

	measure '% Reservas (UF) Top 8' =
			VAR est = SELECTEDVALUE(MART_KPIS_RESERVA[ESTADO])
			VAR base = CALCULATE([# Reservas], REMOVEFILTERS(MART_KPIS_RESERVA[ESTADO]), NOT ISBLANK(MART_KPIS_RESERVA[ESTADO]))
			VAR rk = RANKX(FILTER(ALLSELECTED(MART_KPIS_RESERVA[ESTADO]), NOT ISBLANK(MART_KPIS_RESERVA[ESTADO])), [# Reservas], , DESC, DENSE)
			RETURN IF(NOT ISBLANK(est) && rk <= 8, DIVIDE([# Reservas], base))
		formatString: 0.0%
		displayFolder: Auxiliares
		lineageTag: d16855a7-ed7e-4520-a631-82df2257823b

	measure '% Reservas (Cidade) Top 8' =
			VAR cid = SELECTEDVALUE(MART_KPIS_RESERVA[Cidade Limpa])
			VAR base = CALCULATE([# Reservas], REMOVEFILTERS(MART_KPIS_RESERVA[Cidade Limpa]), NOT ISBLANK(MART_KPIS_RESERVA[Cidade Limpa]))
			VAR rk = RANKX(FILTER(ALLSELECTED(MART_KPIS_RESERVA[Cidade Limpa]), NOT ISBLANK(MART_KPIS_RESERVA[Cidade Limpa])), [# Reservas], , DESC, DENSE)
			RETURN IF(NOT ISBLANK(cid) && rk <= 8, DIVIDE([# Reservas], base))
		formatString: 0.0%
		displayFolder: Auxiliares
		lineageTag: d154efc2-f766-4483-a259-2db19cec79f7

	measure '% Reservas (Antecedencia)' = DIVIDE([# Reservas], CALCULATE([# Reservas], REMOVEFILTERS(MART_KPIS_RESERVA[LEAD_FAIXA]), REMOVEFILTERS(MART_KPIS_RESERVA[Antecedencia]), REMOVEFILTERS(MART_KPIS_RESERVA[Lead Ordem]), NOT ISBLANK(MART_KPIS_RESERVA[LEAD_FAIXA])))
		formatString: 0.0%
		displayFolder: Auxiliares
		lineageTag: 7bf7dd95-385d-4f62-8e29-e548681fbd36

	measure 'Ticket Cidade Top 8' = IF(NOT ISBLANK([% Reservas (Cidade) Top 8]), [Ticket Medio por Reserva])
		formatString: "R$ "#,##0
		lineageTag: 011a7680-b899-431f-b7f1-112519a2bb30


{
  "name": "GuestFlow Dark",
  "dataColors": [
    "#199e70",
    "#9085e9",
    "#d55181",
    "#F2B544",
    "#3FA7D6",
    "#E66767",
    "#5E7391",
    "#A9D4FF"
  ],
  "foreground": "#F1F4FA",
  "foregroundNeutralSecondary": "#A9B6CF",
  "foregroundNeutralTertiary": "#8696B3",
  "background": "#111C30",
  "backgroundLight": "#1A2944",
  "backgroundNeutral": "#26385A",
  "secondaryBackground": "#0A1220",
  "tableAccent": "#F2B544",
  "good": "#199e70",
  "neutral": "#F2B544",
  "bad": "#E66767",
  "maximum": "#B5F5DC",
  "center": "#1F6B5B",
  "minimum": "#16302E",
  "hyperlink": "#A9D4FF",
  "visitedHyperlink": "#9085e9",
  "textClasses": {
    "callout": {
      "fontSize": 48,
      "fontFace": "Segoe UI Semibold",
      "color": "#F1F4FA"
    },
    "title": {
      "fontSize": 17,
      "fontFace": "Segoe UI Semibold",
      "color": "#F1F4FA"
    },
    "header": {
      "fontSize": 14,
      "fontFace": "Segoe UI Semibold",
      "color": "#F1F4FA"
    },
    "label": {
      "fontSize": 12,
      "fontFace": "Segoe UI",
      "color": "#8696B3"
    }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#0A1220"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#05080F"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "*": {
      "*": {
        "*": [
          {
            "fontFamily": "Segoe UI",
            "fontSize": 12
          }
        ],
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#111C30"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#1F2E4A"
              }
            },
            "radius": 14
          }
        ],
        "title": [
          {
            "show": true,
            "text": "",
            "fontColor": {
              "solid": {
                "color": "#F1F4FA"
              }
            },
            "fontSize": 17,
            "fontFamily": "Segoe UI Semibold",
            "alignment": "left"
          }
        ],
        "subTitle": [
          {
            "show": false
          }
        ],
        "visualHeader": [
          {
            "show": false
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "padding": [
          {
            "top": 16,
            "bottom": 12,
            "left": 20,
            "right": 20
          }
        ],
        "legend": [
          {
            "show": true,
            "position": "TopRight",
            "labelColor": {
              "solid": {
                "color": "#A9B6CF"
              }
            },
            "fontSize": 13
          }
        ],
        "categoryAxis": [
          {
            "show": true,
            "showAxisTitle": false,
            "labelColor": {
              "solid": {
                "color": "#8696B3"
              }
            },
            "fontSize": 12,
            "gridlineShow": false,
            "lineColor": {
              "solid": {
                "color": "#1F2E4A"
              }
            }
          }
        ],
        "valueAxis": [
          {
            "show": true,
            "showAxisTitle": false,
            "labelColor": {
              "solid": {
                "color": "#8696B3"
              }
            },
            "fontSize": 12,
            "gridlineShow": true,
            "gridlineColor": {
              "solid": {
                "color": "#1F2E4A"
              }
            },
            "gridlineThickness": 1
          }
        ],
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#F1F4FA"
              }
            },
            "fontSize": 12
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "header": [
          {
            "show": false
          }
        ],
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#111C30"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#26385A"
              }
            },
            "radius": 10
          }
        ],
        "title": [
          {
            "show": false
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "grid": [
          {
            "gridHorizontal": false,
            "gridVertical": false,
            "outlineColor": {
              "solid": {
                "color": "#1F2E4A"
              }
            }
          }
        ],
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#A9B6CF"
              }
            },
            "backColor": {
              "solid": {
                "color": "#111C30"
              }
            },
            "fontSize": 12
          }
        ],
        "rowHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#A9B6CF"
              }
            },
            "backColor": {
              "solid": {
                "color": "#111C30"
              }
            },
            "fontSize": 12
          }
        ],
        "values": [
          {
            "fontColorPrimary": {
              "solid": {
                "color": "#F1F4FA"
              }
            },
            "backColorPrimary": {
              "solid": {
                "color": "#111C30"
              }
            },
            "fontColorSecondary": {
              "solid": {
                "color": "#F1F4FA"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#111C30"
              }
            },
            "fontSize": 13
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "grid": [
          {
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#1F2E4A"
              }
            },
            "gridVertical": false
          }
        ],
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#8696B3"
              }
            },
            "backColor": {
              "solid": {
                "color": "#111C30"
              }
            },
            "fontSize": 12
          }
        ],
        "values": [
          {
            "fontColorPrimary": {
              "solid": {
                "color": "#F1F4FA"
              }
            },
            "backColorPrimary": {
              "solid": {
                "color": "#111C30"
              }
            },
            "fontColorSecondary": {
              "solid": {
                "color": "#F1F4FA"
              }
            },
            "backColorSecondary": {
              "solid": {
                "color": "#111C30"
              }
            },
            "fontSize": 13
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#F1F4FA"
              }
            },
            "fontSize": 48,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "categoryLabels": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#A9B6CF"
              }
            },
            "fontSize": 13
          }
        ]
      }
    },
    "lineChart": {
      "*": {
        "lineStyles": [
          {
            "strokeWidth": 2.5
          }
        ]
      }
    }
  }
}